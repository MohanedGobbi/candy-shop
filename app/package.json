{
  "name": "magasin",
  "version": "1.0.0",
  "private": true,
  "description": "Mouza Shop - caisse et stock",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite",
    "dev": "concurrently -k \"npm:dev:vite\" \"node scripts/wait-and-launch.cjs\"",
    "build:web": "vite build",
    "build:win": "npm run build:web && electron-builder --win --publish never",
    "release": "npm run build:web && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "vite": "^4.5.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.magasin.app",
    "productName": "Mouza Shop",
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mouza Shop"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MohanedGobbi",
        "repo": "candy-shop",
        "releaseType": "release"
      }
    ]
  },
  "author": "Mouza Shop",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohanedGobbi/candy-shop.git"
  }
}
